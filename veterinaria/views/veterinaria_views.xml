<odoo>
    <record id="view_dueno_tre" model="ir.ui.view">
        <field name="name">veterinaria.dueno.tree</field>
        <field name="model">veterinaria.dueno</field>
        <field name="arch" type="xml">
            <tree>
                <field name="nombre"/>
                <field name="telefono"/>
                <field name="email"/>
            </tree>
        </field>
    </record>

    <record id="view_dueno_form" model="ir.ui.view">
        <field name="name">veterinaria.dueno.form</field>
        <field name="model">veterinaria.dueno</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="telefono"/>
                        <field name="email"/>
                    </group>

                    <notebook>
                        <page string="Mascotas">
                            <field name="mascota_ids">
                                <tree>
                                    <field name="nombre"/>
                                    <field name="especie"/>
                                    <field name="edad"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mascota_tree" model="ir.ui.view">
        <field name="name">veterinaria.mascota.tree</field>
        <field name="model">veterinaria.mascota</field>
        <field name="arch" type="xml">
            <tree>
                <field name="nombre"/>
                <field name="especie"/>
                <field name="edad"/>
                <field name="dueno_id"/>
            </tree>
        </field>
    </record>

    <record id="view_mascota_form" model="ir.ui.view">
        <field name="name">veterinaria.mascota.form</field>
        <field name="model">veterinaria.mascota</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="especie"/>
                        <field name="edad"/>
                        <field name="dueno_id"/>
                        <field name="observaciones"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dueno" model="ir.actions.act_window">
        <field name="name">Dueños</field>
        <field name="res_model">veterinaria.dueno</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_mascota" model="ir.actions.act_window">
        <field name="name">Mascotas</field>
        <field name="res_model">veterinaria.mascota</field>
        <field name="view_mode">tree,foem</field>
    </record>

    <menuitem id="menu_veterinaria_root" name="Veterinaria"/>

    <menuitem id="menu_duenos" name="Dueños" parent="menu_veterinaria_root" action="action_dueno"/>

    <menuitem id="menu_mascotas" name="Mascotas" parent="menu_veterinaria_root" action="action_mascota"/>

</odoo>