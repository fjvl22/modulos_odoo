<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aulastock_location_tree" model="ir.ui.view">
        <field name="name">aulastock.location.tree</field>
        <field name="model">aulastock.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="room"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_aulastock_location_form" model="ir.ui.view">
        <field name="name">aulastock.location.form</field>
        <field name="model">aulastock.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="room"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Materiales">
                            <field name="item_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_aulastock_location" model="ir.actions.act_window">
        <field name="name">Ubicaciones</field>
        <field name="res_model">aulastock.location</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>